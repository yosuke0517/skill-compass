{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agents/guard.py\" claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agents/guard.py\" claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
